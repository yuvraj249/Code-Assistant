# CodeMind Backend — Environment Variables
# Copy this file to .env and fill in your values

# Required: OpenAI API key for LLM answers (embeddings are local/free)
OPENAI_API_KEY=sk-...

# Optional: LLM model to use (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Optional: ChromaDB persistence path (default: ./chroma_db)
CHROMA_PATH=./chroma_db

# Optional: Comma-separated allowed CORS origins (default: localhost dev ports)
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:5173
